{
  "version": "0.3.1",
  "description": "Lightweight native Windows runner with an agent-first JSON CLI",
  "homepage": "https://github.com/MatiasFrangolini/soma",
  "license": "MIT",
  "architecture": {
    "64bit": {
      "url": "https://github.com/MatiasFrangolini/soma/releases/download/v0.3.1/Soma-0.3.1-windows-x64.zip",
      "hash": "a5c03a728df6afe5ec74f806d9dde0e50694bc7a8c6d474fc5de6e26ebd5915a"
    }
  },
  "bin": [
    "soma-cli.exe",
    "Soma.exe"
  ],
  "shortcuts": [
    [
      "Soma.exe",
      "Soma"
    ]
  ],
  "pre_install": [
    "$oldCli = Join-Path (appdir $app $global) 'current\\soma-cli.exe'",
    "if (Test-Path -LiteralPath $oldCli) {",
    "    $state = (& $oldCli status | ConvertFrom-Json).status.state",
    "    if ($state -ne 'closed') { throw 'Close Soma before updating or uninstalling. Use soma-cli close for an orderly shutdown.' }",
    "}"
  ],
  "pre_uninstall": [
    "$oldCli = Join-Path (appdir $app $global) 'current\\soma-cli.exe'",
    "if (Test-Path -LiteralPath $oldCli) {",
    "    $state = (& $oldCli status | ConvertFrom-Json).status.state",
    "    if ($state -ne 'closed') { throw 'Close Soma before updating or uninstalling. Use soma-cli close for an orderly shutdown.' }",
    "}"
  ],
  "notes": "Personal configuration and logs stay in USERPROFILE\\.soma. Close Soma before updating. Java is required only for Java projects.",
  "checkver": {
    "github": "https://github.com/MatiasFrangolini/soma"
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/MatiasFrangolini/soma/releases/download/v$version/Soma-$version-windows-x64.zip"
      }
    }
  }
}
