{
  "version": "0.6.0",
  "description": "Lightweight native Windows runner with an optional JSON CLI",
  "homepage": "https://github.com/MatiasFrangolini/soma",
  "license": "MIT",
  "architecture": {
    "64bit": {
      "url": "https://github.com/MatiasFrangolini/soma/releases/download/v0.6.0/Soma-0.6.0-windows-x64.zip",
      "hash": "912658a1682751a0ee708122c45d00ab782ff2449e4c87f35fb06cc4ec1adafa"
    }
  },
  "bin": [
    "soma-cli.exe",
    "Soma.exe",
    [
      "Update-Soma.ps1",
      "soma-update"
    ]
  ],
  "shortcuts": [
    [
      "Soma.exe",
      "Soma"
    ]
  ],
  "pre_install": [
    "$oldCli = Join-Path (appdir $app $global) 'current\\soma-cli.exe'",
    "if (Test-Path -LiteralPath $oldCli) {",
    "    $state = (& $oldCli status | ConvertFrom-Json).status.state",
    "    if ($state -ne 'closed') { throw 'Close Soma before updating or uninstalling. Use soma-cli close for an orderly shutdown.' }",
    "}"
  ],
  "pre_uninstall": [
    "$oldCli = Join-Path (appdir $app $global) 'current\\soma-cli.exe'",
    "if (Test-Path -LiteralPath $oldCli) {",
    "    $state = (& $oldCli status | ConvertFrom-Json).status.state",
    "    if ($state -ne 'closed') { throw 'Close Soma before updating or uninstalling. Use soma-cli close for an orderly shutdown.' }",
    "}"
  ],
  "notes": "Personal configuration and logs stay in USERPROFILE\\.soma. Close Soma and run soma-update to update. Java is required only for Java projects. No AI tools are required.",
  "checkver": {
    "github": "https://github.com/MatiasFrangolini/soma"
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/MatiasFrangolini/soma/releases/download/v$version/Soma-$version-windows-x64.zip"
      }
    }
  }
}
